generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Represents a clinic/organization in the multi-tenant system.
/// Each tenant has a unique slug used in URL routing (/[tenant]/dashboard).
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  settings  Json?
  plan      String   @default("FREE") // FREE, PRO, ENTERPRISE
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  patients Patient[]
}

/// Represents a system user with access roles
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // DOCTOR, RECEPTIONIST, ADMIN
  tenantId  String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// Categorizes patients by condition type (e.g., Diabetic, Cardiac, General)
model PatientType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  patients Patient[]
}

/// Represents a patient registered at the clinic
model Patient {
  id               String   @id @default(uuid())
  patientNumber    String   @unique // Auto-generated: CLINIC-00001
  name             String
  phone            String
  email            String?
  gender           String?  // MALE, FEMALE, OTHER
  dateOfBirth      DateTime?
  bloodGroup       String?  // A+, A-, B+, B-, O+, O-, AB+, AB-
  allergies        String?  // Comma-separated or free text
  chronicConditions String? // Comma-separated or free text
  address          String?
  patientTypeId    String?
  tenantId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientType PatientType? @relation(fields: [patientTypeId], references: [id])
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  visits      Visit[]
  followUps   FollowUp[]

  @@index([phone])
  @@index([patientNumber])
  @@index([createdAt])
  @@index([name])
  @@index([tenantId])
}

/// Represents a clinical visit / encounter (EMR entry)
/// Visit records are immutable — no destructive updates allowed
model Visit {
  id            String   @id @default(uuid())
  patientId     String

  visitDate     DateTime @default(now())

  // Vitals
  bp            String?  // e.g., "120/80"
  temperature   Float?   // in °F or °C
  pulse         Int?     // beats per minute
  weight        Float?   // in kg
  height        Float?   // in meters
  bmi           Float?

  // Risk Factors
  isNonVeg      Boolean?
  alcohol       Boolean?
  smoking       Boolean?
  drugAllergy   String?
  surgeryHistory String?

  // Clinical
  symptoms      String?  // Free text (Legacy)
  diagnosis     String?  // Free text (Legacy)
  prescription  String?  // Structured or free text
  labTests      String?  // Free text (Legacy)
  chiefComplaint String?
  historyOfPresentIllness String?
  examination   String?
  provisionalDiagnosis String?
  investigations String?
  finalDiagnosis String?

  // Scheduling
  nextVisitDate DateTime?

  // Billing
  fee           Float?
  paymentMode   String?  // CASH, UPI, CARD, INSURANCE

  notes         String?
  createdAt     DateTime @default(now())

  patient   Patient    @relation(fields: [patientId], references: [id])
  followUps FollowUp[]

  @@index([patientId])
  @@index([visitDate])
  @@index([nextVisitDate])
}

/// Represents a follow-up action / appointment reminder for a patient
model FollowUp {
  id             String   @id @default(uuid())
  patientId      String
  visitId        String?

  followUpDate   DateTime
  method         String   // CALL, WHATSAPP, SMS, VISIT
  status         String   @default("CONFIRMED") // CONFIRMED, NO_RESPONSE, RESCHEDULED, VISITED, MISSED
  notes          String?
  nextFollowUpOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  visit   Visit?  @relation(fields: [visitId], references: [id])

  @@index([patientId])
  @@index([followUpDate])
  @@index([status])
}

/// Tracks user actions for compliance and security audit trails.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity     String   // Patient, Visit, FollowUp, etc.
  entityId   String?
  metadata   Json?    // Additional context
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
