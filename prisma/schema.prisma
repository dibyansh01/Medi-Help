generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Represents a system user with access roles
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // DOCTOR, RECEPTIONIST, ADMIN
  createdAt DateTime @default(now())
}

/// Categorizes patients by condition type (e.g., Diabetic, Cardiac, General)
model PatientType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  patients Patient[]
}

/// Represents a patient registered at the clinic
model Patient {
  id               String   @id @default(uuid())
  patientNumber    String   @unique // Auto-generated: CLINIC-00001
  name             String
  phone            String
  email            String?
  gender           String?  // MALE, FEMALE, OTHER
  dateOfBirth      DateTime?
  bloodGroup       String?  // A+, A-, B+, B-, O+, O-, AB+, AB-
  allergies        String?  // Comma-separated or free text
  chronicConditions String? // Comma-separated or free text
  address          String?
  patientTypeId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientType PatientType? @relation(fields: [patientTypeId], references: [id])
  visits      Visit[]
  followUps   FollowUp[]

  @@index([phone])
  @@index([patientNumber])
  @@index([createdAt])
  @@index([name])
}

/// Represents a clinical visit / encounter (EMR entry)
/// Visit records are immutable — no destructive updates allowed
model Visit {
  id            String   @id @default(uuid())
  patientId     String

  visitDate     DateTime @default(now())

  // Vitals
  bp            String?  // e.g., "120/80"
  temperature   Float?   // in °F or °C
  pulse         Int?     // beats per minute
  weight        Float?   // in kg

  // Clinical
  symptoms      String?  // Free text
  diagnosis     String?  // Free text
  prescription  String?  // Structured or free text
  labTests      String?  // Free text

  // Scheduling
  nextVisitDate DateTime?

  // Billing
  fee           Float?
  paymentMode   String?  // CASH, UPI, CARD, INSURANCE

  notes         String?
  createdAt     DateTime @default(now())

  patient   Patient    @relation(fields: [patientId], references: [id])
  followUps FollowUp[]

  @@index([patientId])
  @@index([visitDate])
  @@index([nextVisitDate])
}

/// Represents a follow-up action / appointment reminder for a patient
model FollowUp {
  id             String   @id @default(uuid())
  patientId      String
  visitId        String?

  followUpDate   DateTime
  method         String   // CALL, WHATSAPP, SMS, VISIT
  status         String   @default("CONFIRMED") // CONFIRMED, NO_RESPONSE, RESCHEDULED, VISITED, MISSED
  notes          String?
  nextFollowUpOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  visit   Visit?  @relation(fields: [visitId], references: [id])

  @@index([patientId])
  @@index([followUpDate])
  @@index([status])
}
