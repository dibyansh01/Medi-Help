generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Represents a system user with access roles
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // OWNER, ACCOUNTS, SALES
  createdAt DateTime @default(now())
}

/// Represents a client or customer of the business
model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  location    String?  // City or Region

  creditTerms Int?     // Number of days for credit
  notes       String?  // Additional notes
  createdAt   DateTime @default(now())

  invoices    Invoice[]
}

/// Represents an invoice generated for a customer
model Invoice {
  id            String   @id @default(uuid())
  customerId    String
  invoiceNo     String   // Unique invoice number
  invoiceDate   DateTime
  dueDate       DateTime
  
  invoiceAmount Float    // Base amount (excluding GST)
  gstAmount     Float?   // GST charged on invoice (optional)
  gstRate       Float?   // GST rate (e.g. 5, 12, 18)
  isGstInclusive Boolean  @default(false)

  paidAmount    Float    @default(0)
  outstandingAmount Float // Base amount + GST - paidAmount

  status        String   // UNPAID, PARTIAL, PAID, OVERDUE
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  followUps FollowUp[]   
  payments   PaymentEntry[] 
  @@index([customerId])
  @@index([dueDate])
  @@index([status])
}

/// Represents a follow-up action taken for an invoice
model FollowUp {
  id              String   @id @default(uuid())
  invoiceId       String
  followUpDate    DateTime @default(now())
  method          String   // CALL, WHATSAPP, EMAIL, VISIT
  status          String   // PROMISED, NO_RESPONSE, PAID, DISPUTED
  notes           String?
  nextFollowUpOn  DateTime?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

/// Represents a payment received for an invoice
model PaymentEntry {
  id          String   @id @default(uuid())
  invoiceId  String
  amount     Float
  paymentDate DateTime @default(now())
  method      String   // CASH, UPI, BANK, CHEQUE, OTHER
  reference   String?  // Transaction ID or Cheque Number
  notes       String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

/// ======================================================
/// ================= CASH OUT ============================
/// ======================================================


/// =====================
/// VENDORS
/// =====================
model Vendor {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  creditTerms Int?     // days
  notes       String?
  createdAt   DateTime @default(now())

  expenses        Expense[]
  invoices        VendorInvoice[]
}

/// =====================
/// EXPENSE CATEGORIES
/// =====================
model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   // Rent, Salary, Raw Material, etc.
  createdAt DateTime @default(now())

  expenses Expense[]
}

/// =====================
/// EXPENSE (IMMEDIATE CASH OUT)
/// =====================
model Expense {
  id          String   @id @default(uuid())
  vendorId    String?
  categoryId  String
  expenseDate DateTime
  amount      Float   // Base expense amount
  gstAmount     Float?
  gstRate       Float?
  isGstInclusive Boolean @default(false)
  isGstEligible  Boolean @default(false)
  paymentMode String   // CASH, BANK, UPI
  notes       String?
  createdAt   DateTime @default(now())

  vendor   Vendor?         @relation(fields: [vendorId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([expenseDate])
}

/// =====================
/// VENDOR INVOICE (CREDIT)
/// =====================
model VendorInvoice {
  id                String   @id @default(uuid())
  vendorId          String
  invoiceNo         String
  invoiceDate       DateTime
  dueDate           DateTime

  invoiceAmount     Float    // Base amount (excluding GST)
  gstAmount         Float?
  gstRate           Float?
  isGstInclusive    Boolean  @default(false)
  isGstEligible     Boolean  @default(true)
  paidAmount        Float    @default(0)
  outstandingAmount Float

  status            String   // UNPAID, PARTIAL, PAID
  description       String?
  createdAt         DateTime @default(now())

  vendor   Vendor @relation(fields: [vendorId], references: [id])
  payments VendorPayment[]

  @@index([vendorId])
  @@index([dueDate])
}

/// =====================
/// VENDOR PAYMENT
/// =====================
model VendorPayment {
  id              String   @id @default(uuid())
  vendorInvoiceId String
  amount          Float
  paymentDate     DateTime @default(now())
  method          String   // CASH, UPI, BANK, CHEQUE
  reference       String?  // Transaction ID
  notes           String?
  createdAt       DateTime @default(now())

  vendorInvoice VendorInvoice @relation(fields: [vendorInvoiceId], references: [id])

  @@index([vendorInvoiceId])
}
